# ---------------------------------------------------------------------------
# SMS Spam Detector - environment configuration
#
# Copy this file to `.env` (never committed) and adjust the values:
#     cp .env.example .env
#
# Docker Compose, the Django settings module and the ML layer all read these
# variables. Every one of them has a safe default for local development.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Development: keep DEBUG enabled. Production: set to 0 and provide a real key.
DJANGO_DEBUG=1

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

# Comma separated host names. In production list the real hostnames, e.g.
# DJANGO_ALLOWED_HOSTS=sms.example.edu,www.sms.example.edu
DJANGO_ALLOWED_HOSTS=*

# Required when the app is served over HTTPS behind a proxy (Django 4+):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sms.example.edu

# Empty in development (allows embedding in local preview panes); DENY in production.
DJANGO_X_FRAME_OPTIONS=

DJANGO_LOG_LEVEL=INFO

# Skip the "are the models trained?" log line at startup (useful before the first
# training run or while running migrations in CI).
DJANGO_SKIP_STARTUP_CHECK=0

# --- Storage paths ---------------------------------------------------------
DJANGO_DB_PATH=data/db.sqlite3
MODEL_ARTIFACTS_DIR=artifacts
DATA_DIR=data/raw

# --- Detector behaviour ----------------------------------------------------
DETECTOR_DEFAULT_MODEL=linear_svm
DETECTOR_MAX_MESSAGE_LENGTH=1600

# --- Docker ---------------------------------------------------------------
WEB_PORT=8000
GUNICORN_WORKERS=3

# --- Production hardening (only applied when DJANGO_DEBUG=0) --------------
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
