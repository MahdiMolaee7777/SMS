# ---------------------------------------------------------------------------
# Kept out of the Docker build context.
#
# Trained artefacts and the SQLite database are NOT baked into the image: they
# are created by `manage.py train_models` / `migrate` and stored in mounted
# volumes (see docker-compose.yml).
# ---------------------------------------------------------------------------

.git
.gitignore
.github

# Python caches / virtual environments
__pycache__
**/__pycache__
*.py[cod]
.venv
venv
env
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Generated at runtime
artifacts/**
!artifacts/.gitkeep
staticfiles
*.sqlite3
data/db.sqlite3
node_modules
.env
.env.*

# Editor / OS noise
.idea
.vscode
.DS_Store
Thumbs.db

# Front-end tooling cache (the compiled CSS itself IS needed)
.npm
.cache
tailwindcss
